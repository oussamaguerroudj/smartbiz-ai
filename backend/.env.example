NODE_ENV=development
PORT=4000

# Matches the Phase 3 database (docker-compose.yml credentials, or your
# own local PostgreSQL install — see database/README.md)
DATABASE_URL=postgresql://smartbiz:smartbiz_dev_password@localhost:5432/smartbiz

# Generate real random secrets for these — do NOT use these placeholder
# values beyond local testing. Easiest way: run
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# and paste the output for each.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d

CORS_ORIGIN=*

# Google OAuth Configuration
GOOGLE_CLIENT_ID=128675361201-9sql94sb7b2av7upaksoqunkvs1c4amp.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=128675361201-s1qac05sj36egh69a054ljmqukptt4tl.apps.googleusercontent.com
GOOGLE_WINDOWS_CLIENT_ID=128675361201-qhb7u121simtqfq3nubaek2nhk0qae2f.apps.googleusercontent.com
# Confidential client secret for Windows desktop OAuth code exchange (keep secret on server)
GOOGLE_WINDOWS_CLIENT_SECRET=

# AI Configuration
# Production (Ollama Cloud - no local PC needed):
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_VISION_MODEL=gemma4:31b
# OLLAMA_OCR_MODEL=gemma4:31b

# Local Development (Self-hosted local Ollama on PC):
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=not-needed
AI_VISION_MODEL=qwen2.5vl:7b
AI_CHAT_MODEL=qwen2.5:7b
AI_OCR_MODEL=glm-ocr:latest
# Optional companion OCR microservice (backend/ocr-service, PaddleOCR).
# Leave blank to use Ollama GLM-OCR directly.
OCR_SERVICE_URL=

# Required for email verification (registration) and forgot-password to
# actually deliver mail. Any standard SMTP provider works (SendGrid,
# Mailgun, AWS SES, or Gmail SMTP with an app password for early
# testing). Leave SMTP_HOST blank and these features will fail loudly
# with a clear server-side log line instead of silently pretending to
# send an email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Modiri AI <no-reply@modiri.ai>
